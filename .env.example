# NBA 2K26 Stats Tracker - Environment Variables
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and replace the placeholder with your real API key
# 3. Your API key will be loaded automatically when you start the server
#
# Get your API key from: https://console.anthropic.com
# IMPORTANT: Never commit the .env file to git (already in .gitignore)

ANTHROPIC_API_KEY=sk-ant-your-api-key-here
